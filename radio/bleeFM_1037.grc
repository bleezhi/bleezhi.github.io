options:
  parameters:
    author: bleez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'bleeFM 103.7 FM transmitter: ALSA loopback -> WBFM -> TCP IQ for SimTx'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: bleefm_1037
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{filename}.py'
    thread_safe_setters: ''
    title: 'bleeFM 103.7 FM transmitter'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: audio_rate
  id: variable
  parameters:
    comment: ''
    value: '48000'
  states:
    coordinate: [8, 8]
    rotation: 0
    state: enabled
- name: quad_rate
  id: variable
  parameters:
    comment: ''
    value: '192000'
  states:
    coordinate: [8, 60]
    rotation: 0
    state: enabled
- name: max_dev
  id: variable
  parameters:
    comment: ''
    value: '75000'
  states:
    coordinate: [8, 112]
    rotation: 0
    state: enabled
- name: tcp_host
  id: variable
  parameters:
    comment: ''
    value: '''127.0.0.1'''
  states:
    coordinate: [8, 164]
    rotation: 0
    state: enabled
- name: tcp_port
  id: variable
  parameters:
    comment: ''
    value: '7355'
  states:
    coordinate: [8, 216]
    rotation: 0
    state: enabled
- name: audio_source_0
  id: audio_source
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_name: '''hw:3,1'''
    num_inputs: '1'
    ok_to_block: 'True'
    sample_rate: audio_rate
  states:
    coordinate: [168, 188]
    rotation: 0
    state: enabled
- name: analog_wfm_tx_0
  id: analog_wfm_tx
  parameters:
    affinity: ''
    alias: ''
    audio_rate: audio_rate
    comment: ''
    fh: '0.0'
    max_dev: max_dev
    quad_rate: quad_rate
    tau: 75e-6
  states:
    coordinate: [408, 188]
    rotation: 0
    state: enabled
- name: blocks_tcp_sink_0
  id: blocks_tcp_sink
  parameters:
    addr: tcp_host
    affinity: ''
    alias: ''
    comment: ''
    port: tcp_port
    server: 'True'
    type: complex
  states:
    coordinate: [648, 188]
    rotation: 0
    state: enabled

connections:
- [audio_source_0, '0', analog_wfm_tx_0, '0']
- [analog_wfm_tx_0, '0', blocks_tcp_sink_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.0
